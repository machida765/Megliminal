# 画面だけ触る（クラウドにもローカル Supabase にも行かない）
NEXT_PUBLIC_DATA_SOURCE=local

# PC 上の Supabase を使うとき（Docker 起動後）
# NEXT_PUBLIC_DATA_SOURCE=supabase
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=（npm run supabase:status に表示される anon key）

# クラウドの Supabase を使うとき
# NEXT_PUBLIC_DATA_SOURCE=supabase
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=（プロジェクトの anon key）
