# このファイルは Git にコミットしない（雛形）
# 開発と本番は別の Supabase にする。本番の URL とキーはここへ書かず、Vercel の環境変数だけに置く。

# --- 開発（PC 上の Docker）---
# npm run supabase:status の表示と対応:
#   Publishable → NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Secret      → SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=（status の Publishable）
SUPABASE_SERVICE_ROLE_KEY=（status の Secret）

# 管理画面を開けるユーザー（profiles.role = admin かつこの UUID のみ）
# 未設定時は role=admin の全員がアクセス可（開発・テスト用）
ADMIN_USER_ID=
NEXT_PUBLIC_ADMIN_USER_ID=

# --- 本番 ---
# Supabase で開発用とは別のプロジェクトを作り、次の3つを Vercel の Environment Variables に入れる。
# NEXT_PUBLIC_SUPABASE_URL=https://（本番の project-ref）.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=（本番 Dashboard > Settings > API > Publishable key）
# SUPABASE_SERVICE_ROLE_KEY=（本番 Dashboard > Settings > API > Secret key）
