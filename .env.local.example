# 環境変数テンプレート（コピーして .env.local を作成）

# ── データソース切り替え ──
# local     … ダミーデータ + ローカル認証（投稿テスト向け・デフォルト）
#             テストログイン: taro@test.local / パスワード任意
#             または画面右下の「Local 投稿テスト」パネル
# supabase  … Supabase 認証 + DB（接続テスト・本番向け）
NEXT_PUBLIC_DATA_SOURCE=local

# ── Supabase（DATA_SOURCE=supabase のとき必要）──
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Publishable key（sb_publishable_...）または anon public キー（eyJ...）
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
